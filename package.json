{
  "name": "job-application-platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:migrate": "cd phases/p0/packages/shared && npx drizzle-kit push",
    "db:seed": "tsx phases/p0/packages/shared/db/seed.ts",
    "db:generate": "cd phases/p0/packages/shared && npx drizzle-kit generate",
    "next-build": "cd phases/p0/apps/web && npx next build"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@vercel/analytics": "^1.4.0",
    "@vercel/speed-insights": "^1.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "phases/p0/apps/*",
    "phases/p0/packages/*"
  ],
  "dependencies": {
    "vitest": "^4.1.9"
  }
}
