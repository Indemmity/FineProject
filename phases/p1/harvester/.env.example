# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobplatform

# ─── Scraping ────────────────────────────────────────────────
NAUKRI_BASE_URL=https://www.naukri.com
REMOTEOK_API_URL=https://remoteok.com/api
WELLFOUND_BASE_URL=https://wellfound.com

# Selenium
SELENIUM_TIMEOUT=30
USER_AGENT_ROTATION=true

# Firecrawl (optional)
FIRECRAWL_API_KEY=

# ─── General ─────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_RESULTS_PER_SOURCE=100