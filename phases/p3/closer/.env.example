# ─── SMTP ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=

# ─── Operation ───────────────────────────────────────────────
DRY_RUN=true
SEND_MODE=draft
MAX_OUTREACH_PER_RUN=5

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_EMAILS_PER_HOUR=20
RATE_LIMIT_EMAILS_PER_DAY=100

# ─── General ─────────────────────────────────────────────────
LOG_LEVEL=INFO