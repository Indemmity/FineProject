# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobplatform
REDIS_URL=redis://localhost:6379

# ─── LLM ─────────────────────────────────────────────────────
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=30000
LLM_CACHE_ENABLED=true

# ─── SMTP ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=

# ─── Outreach ────────────────────────────────────────────────
DRY_RUN=true
SEND_MODE=draft
MAX_OUTREACH_PER_RUN=5
RATE_LIMIT_EMAILS_PER_HOUR=20

# ─── Features ────────────────────────────────────────────────
MOCK_MODE=true
ENABLE_URL_SCRAPE=false
ENABLE_TRACKING_PIXEL=false